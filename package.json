{
  "name": "blokwoorden",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @blokwoorden/game",
    "dev:game": "npm run dev -w @blokwoorden/game",
    "dev:admin": "npm run dev -w @blokwoorden/admin",
    "build": "npm run build:game",
    "build:game": "npm run build -w @blokwoorden/game",
    "build:admin": "npm run build -w @blokwoorden/admin",
    "preview:game": "npm run preview -w @blokwoorden/game",
    "preview:admin": "npm run preview -w @blokwoorden/admin",
    "generate:seed": "node scripts/generate-seed.mjs"
  }
}
